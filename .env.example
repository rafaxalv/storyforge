# Copy to .env for local development. Placeholders only - never commit real values.
NODE_ENV=development
PORT=3000

# Postgres from docker compose (dev-only credentials)
POSTGRES_USER=storyforge
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://storyforge:change-me-local-only@127.0.0.1:5432/storyforge
DATABASE_URL_TEST=postgres://storyforge:change-me-local-only@127.0.0.1:5432/storyforge_test

# MinIO from docker compose (used from E03)
MINIO_ROOT_USER=storyforge
MINIO_ROOT_PASSWORD=change-me-local-only

# Logging: trace|debug|info|warn|error|fatal|silent; LOG_FILE empty disables the file sink
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Claude: "fake" replays tests/fixtures/claude; "anthropic" calls the API and needs ANTHROPIC_API_KEY
AI_CLIENT=fake
ANTHROPIC_API_KEY=
