# Copy to .env for local development. Placeholders only - never commit real values.
NODE_ENV=development
PORT=3000

# Postgres from docker compose (dev-only credentials)
POSTGRES_USER=storyforge
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://storyforge:change-me-local-only@127.0.0.1:5432/storyforge
DATABASE_URL_TEST=postgres://storyforge:change-me-local-only@127.0.0.1:5432/storyforge_test

# Logging: trace|debug|info|warn|error|fatal|silent; LOG_FILE empty disables the file sink
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Claude: "fake" replays tests/fixtures/claude; "anthropic" calls the API and needs ANTHROPIC_API_KEY
AI_CLIENT=fake
ANTHROPIC_API_KEY=

# Auth (Better Auth). Replace the secret with your own: openssl rand -base64 32
BETTER_AUTH_SECRET=local-only-placeholder-secret-change-me-0000
BETTER_AUTH_URL=http://localhost:3000
# Number of reverse proxies in front of the app (0 = none); rate limits then use X-Forwarded-For
TRUST_PROXY_HOPS=0
# Comma-separated emails that get the admin role
ADMIN_EMAILS=
# Google sign-in: set both or neither (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: console (prints sign-in links in the dev terminal) | outbox (JSON files in MAIL_OUTBOX_DIR) | smtp
EMAIL_TRANSPORT=console
MAIL_OUTBOX_DIR=logs/outbox
SMTP_URL=
MAIL_FROM=storyforge <no-reply@localhost>
