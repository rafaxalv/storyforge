{
  "name": "storyforge",
  "version": "0.1.0",
  "private": true,
  "description": "A writing desk for authors: the hosted successor to cowriter.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./src/app --ignore ./.next src/server/main.ts",
    "build": "next build && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node dist/main.js",
    "worker": "tsx watch --clear-screen=false src/worker.ts",
    "worker:start": "NODE_ENV=production node dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "drizzle-orm": "0.45.4",
    "next": "15.5.29",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "postcss": "8.5.33"
  }
}
